{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "testMatch": ["**/tests/**/*.test.ts"],
  "setupFiles": ["<rootDir>/src/tests/setupEnv.ts"],
  "globalSetup": "<rootDir>/src/tests/globalSetup.js",
  "globalTeardown": "<rootDir>/src/tests/globalTeardown.js",
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/index.ts"
  ]
}
