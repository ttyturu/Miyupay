DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/your_db_name
JWT_SECRET=change_me_to_a_long_random_string
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
PORT=3001

# Stripe (test mode) — used for the "Add Credit" top-up flow.
# Get test keys from https://dashboard.stripe.com/test/apikeys after creating a free account.
STRIPE_SECRET_KEY=sk_test_your_key_here

# Signing secret for the /api/webhooks/stripe endpoint. Without it a paid
# top-up is only credited if the customer's browser survives the redirect back
# from Stripe — close the tab after paying and the money is taken but never
# credited. Locally: `stripe listen --forward-to localhost:3001/api/webhooks/stripe`
# prints a whsec_... to paste here. In production, copy it from the endpoint you
# create at https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_signing_secret_here

# Groq (optional) — powers the AI transaction summary on the admin panel.
# Free tier, no card required: https://console.groq.com/keys
# If unset, the summary endpoint returns a "not configured" message instead of erroring.
GROQ_API_KEY=your_groq_api_key_here
